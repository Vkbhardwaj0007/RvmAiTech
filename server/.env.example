PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/rvmaitech
JWT_SECRET=change_this_to_a_long_random_string
# admin session length (e.g. 7d for a week)
JWT_EXPIRES_IN=12h
SEED_ADMIN_NAME=Admin
SEED_ADMIN_USERID=admin
SEED_ADMIN_PASSWORD=Admin@123

# Contact form email alerts (optional — blank SMTP_* = log only, no crash)
CONTACT_EMAIL=
MAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Production
SITE_URL=
SERVE_CLIENT=false
CLIENT_URL=http://localhost:5173
