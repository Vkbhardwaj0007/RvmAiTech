############################################################
# RvmAiTech API — environment
#
# Copy to server/.env and fill in. The server validates these
# at boot and REFUSES TO START on a dangerous combination
# (placeholder secret, wildcard CORS, insecure cookies in
# production). See src/config/env.js.
############################################################

PORT=4000
NODE_ENV=development

# ---------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------

# Signs access tokens. Minimum 32 characters; the server refuses
# to start with the placeholder below or anything shorter.
#   generate with:  openssl rand -base64 48
# Changing this signs out every admin immediately.
JWT_SECRET=change_this_to_a_long_random_string

# ---------------------------------------------------------------
# Database
# ---------------------------------------------------------------

MONGO_URI=mongodb://127.0.0.1:27017/rvmaitech

# ---------------------------------------------------------------
# Origins and cookies
# ---------------------------------------------------------------

# Comma-separated allowlist. "*" is rejected: the refresh cookie
# requires credentialed CORS, and a wildcard origin with
# credentials would let any website read authenticated responses.
CORS_ORIGIN=http://localhost:5173

# Where the admin UI lives. Used to build password-reset links.
CLIENT_URL=http://localhost:5173

# Public site URL. Also used to build upload URLs, instead of
# trusting the request's Host header.
SITE_URL=

# Send cookies only over HTTPS. Defaults to true in production
# and false in development; override only if you know why.
# COOKIE_SECURE=true

# Set to true ONLY when the API and the site are on different
# registrable domains (e.g. api.rvmaitech.com + rvmaitech.com),
# which needs SameSite=None. Requires COOKIE_SECURE=true.
# CROSS_SITE_COOKIES=false

# COOKIE_DOMAIN=.rvmaitech.com

# ---------------------------------------------------------------
# Reverse proxy
# ---------------------------------------------------------------

# Number of trusted proxy hops in front of this app.
#   0  nothing in front (default)
#   1  Nginx, Render, Railway, Fly, a single load balancer
#
# This must NOT be set to "true". With blanket trust, a client can
# send its own X-Forwarded-For header and get a fresh IP rate-limit
# bucket on every request, which removes the brute-force protection.
TRUST_PROXY=0

# ---------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------

# Access token lifetime. Kept short because it cannot be revoked;
# the refresh cookie is what provides a long session. Max 1h.
ACCESS_TOKEN_TTL=15m

# Refresh cookie lifetime — how long a session may sit idle. This is a
# SLIDING window: every refresh extends it.
REFRESH_TOKEN_TTL=7d

# Hard ceiling on a session, measured from the original sign-in and not
# extended by refreshing. Without this, a session (including a stolen one)
# could be kept alive indefinitely by refreshing inside the window above.
SESSION_MAX_LIFETIME=30d

# How long a password-reset link stays valid.
RESET_TOKEN_TTL=30m

# Legacy name for the access token lifetime, still read. Note the
# old value of 12h is now rejected: see ACCESS_TOKEN_TTL.
# JWT_EXPIRES_IN=15m

# ---------------------------------------------------------------
# Password policy and hashing
# ---------------------------------------------------------------

PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128

# Optional: a newline-separated file of banned passwords, e.g. the
# SecLists top-100k. Without it a short built-in list is used.
# PASSWORD_DENYLIST_FILE=/etc/rvmaitech/common-passwords.txt

# Argon2id parameters. Defaults exceed the OWASP floor
# (m=19456 t=2 p=1). Raise memory if your host can afford it.
# ARGON2_MEMORY_KIB=65536
# ARGON2_TIME_COST=3
# ARGON2_PARALLELISM=1

# ---------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------

# The store must be shared across instances or every limit is
# multiplied by the number of processes. With REDIS_URL set, Redis
# is used; without it, MongoDB is (which still works across
# instances, just with more database traffic).
# REDIS_URL=redis://127.0.0.1:6379

# RL_LOGIN_PER_IP=20        # per 15 minutes
# RL_AUTH_PER_IP=60         # any /api/auth call, per minute
# RL_FORGOT_PER_IP=5        # per hour
# RL_FORGOT_PER_ACCOUNT=3   # per hour
# RL_RESET_PER_IP=10        # per hour
# RL_ACCOUNT_FAILURES=5     # failures before backoff starts
# RL_ACCOUNT_MAX_BLOCK=900  # backoff ceiling in seconds (never permanent)
# RL_ACCOUNT_WINDOW=1800    # how long a failure streak is remembered
# RL_PUBLIC_FORM_PER_IP=10  # contact form / job applications, per hour
# RL_UPLOAD_PER_IP=60       # per hour

# Largest accepted JSON body.
# JSON_BODY_LIMIT=100kb

# ---------------------------------------------------------------
# Seeding
# ---------------------------------------------------------------

SEED_ADMIN_NAME=Admin
SEED_ADMIN_USERID=admin

# Leave BLANK to have a strong password generated and printed once
# when you run `npm run seed`. If you set it, it must satisfy the
# password policy — there is no weak default any more.
SEED_ADMIN_PASSWORD=

# ---------------------------------------------------------------
# Email (contact form alerts + password resets)
# ---------------------------------------------------------------

CONTACT_EMAIL=
MAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Development only: print reset links to the console when no SMTP
# is configured. Forced off in production.
# DEV_LOG_RESET_LINKS=false

# ---------------------------------------------------------------
# Audit log
# ---------------------------------------------------------------

# Days of authentication history to keep (TTL index).
# AUDIT_RETENTION_DAYS=180

# ---------------------------------------------------------------
# Content Security Policy extras
# ---------------------------------------------------------------

# Comma-separated extra origins, if you load third-party assets.
# Prefer adding them here over loosening the defaults in app.js.
# CSP_EXTRA_SCRIPT_SRC=https://www.googletagmanager.com
# CSP_EXTRA_CONNECT_SRC=https://www.google-analytics.com
# CSP_EXTRA_IMG_SRC=https://www.google-analytics.com
# CSP_EXTRA_STYLE_SRC=https://fonts.googleapis.com
# CSP_EXTRA_FONT_SRC=https://fonts.gstatic.com

# ---------------------------------------------------------------
# Frontend serving
# ---------------------------------------------------------------

# true = this server also serves web/dist (same origin, no CORS needed)
SERVE_CLIENT=false
