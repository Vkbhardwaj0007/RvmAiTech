node_modules/
*.log

# Secrets. The broad .env* pattern matters: a file like
# .env.backup, .env.local or .env.production.bak holds the same
# live credentials as .env and is the usual way they get committed
# by accident.
.env
.env.*
!.env.example

# Build output (commit web/dist so production hosts always have the bundle ready)
dist/
!web/dist/
*.bak

# Uploaded media: ignore large videos and resumes, but track image uploads
server/uploads/*.mp4
server/uploads/*.webm
server/uploads/resumes/*
!server/uploads/*.jpg
!server/uploads/*.jpeg
!server/uploads/*.png
!server/uploads/*.webp
!server/uploads/*.svg
!server/uploads/.gitkeep
